# Multi-Tenant SaaS Platform - Production Environment Variables Template

# Application Environment
NODE_ENV=production
PORT=3001
BACKEND_PORT=3001
FRONTEND_PORT=3000

# PostgreSQL Production Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=saas_platform_prod
POSTGRES_USER=postgres_prod_user
POSTGRES_PASSWORD=change_me_production_postgres_password_123
DATABASE_URL=postgresql://postgres_prod_user:change_me_production_postgres_password_123@postgres:5432/saas_platform_prod?schema=public

# Redis Production In-Memory Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Authentication Security Secret Keys
JWT_SECRET=change_me_production_jwt_secret_key_987654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
