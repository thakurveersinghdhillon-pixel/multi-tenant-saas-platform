NODE_ENV=development

# Backend
BACKEND_PORT=3001

# Database Configuration (Prisma / PostgreSQL)
# Docker: postgresql://postgres:postgres@postgres:5432/saas_platform?schema=public
# Local:  postgresql://postgres:postgres@localhost:5432/saas_platform?schema=public
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/saas_platform?schema=public

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=saas_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=change_me_jwt_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
